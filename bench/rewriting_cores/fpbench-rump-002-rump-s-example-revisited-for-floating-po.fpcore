(FPCore (a b)
  :name "Rump's example revisited for floating point"
  :cx-source "fpbench:rump.fpcore:2"
  :cx-box "default"
  :precision binary64
  :pre (and (<= 1 a 2) (<= 4 b 8))
  (+ (+ (+ (* (- 333.75 (* a a)) (* (* (* b b) (* b b)) (* b b))) (* (* a a) (- (- (* (* 11 (* a a)) (* b b)) (* 121 (* (* b b) (* b b)))) 2))) (* 5.5 (* (* (* b b) (* b b)) (* (* b b) (* b b))))) (/ a (* 2 b))))
