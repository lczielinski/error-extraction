(FPCore (x eps)
  :name "ENA, Section 1.4, Exercise 4b, n=5"
  :cx-source "herbie:numerics/conte.fpcore:5"
  :cx-box "pre"
  :precision binary64
  :pre (and (<= -1000000000 x 1000000000) (<= -1 eps 1))
