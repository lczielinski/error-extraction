(FPCore (x y z t a b)
  :name "Diagrams.Solve.Polynomial:cubForm  from diagrams-solve-0.1, A"
  :cx-source "herbie:haskell.fpcore:45"
  :cx-box "default"
  :precision binary64
  :pre (and (<= 1 x 2) (<= 4 y 8) (<= 16 z 32) (<= 64 t 128) (<= 256 a 512) (<= 1024 b 2048))
  (+ (- (* x 2) (* (* (* y 9) z) t)) (* (* a 27) b)))
