(FPCore (x y z t a b c i)
  :name "Linear.V4:$cdot from linear-1.19.1.3, C"
  :cx-source "herbie:haskell.fpcore:68"
  :cx-box "default"
  :precision binary64
  :pre (and (<= 1 x 2) (<= 4 y 8) (<= 16 z 32) (<= 64 t 128) (<= 256 a 512) (<= 1024 b 2048) (<= 4096 c 8192) (<= 16384 i 32768))
  (+ (+ (+ (* x y) (* z t)) (* a b)) (* c i)))
