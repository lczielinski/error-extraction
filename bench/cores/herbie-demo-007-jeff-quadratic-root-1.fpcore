(FPCore (a b c)
  :name "jeff quadratic root 1"
  :cx-source "herbie:demo.fpcore:7"
  :cx-box "default"
  :precision binary64
  :pre (and (<= -2 a -1) (<= 4 b 8) (<= 16 c 32))
  (if (>= b 0) (/ (- (- b) (sqrt (- (* b b) (* (* 4 a) c)))) (* 2 a)) (/ (* 2 c) (+ (- b) (sqrt (- (* b b) (* (* 4 a) c)))))))
