; from herbie haskell.fpcore core 13
; box: default
(FPCore (x y z t a)
  :name "Data.Colour.RGB:hslsv from colour-2.3.3, B"
  :cx-source "herbie:haskell.fpcore:13"
  :cx-box "default"
  :pre (and (<= 1.0 x 2.0) (<= 4.0 y 8.0) (<= 16.0 z 32.0) (<= 64.0 t 128.0) (<= 256.0 a 512.0))
  (+ (/ (* 60 (- x y)) (- z t)) (* a 120)))
