; from herbie haskell.fpcore core 5
; box: default
(FPCore (x y z t a)
  :name "Optimisation.CirclePacking:place from circle-packing-0.1.0.4, F"
  :cx-source "herbie:haskell.fpcore:5"
  :cx-box "default"
  :pre (and (<= 1.0 x 2.0) (<= 4.0 y 8.0) (<= 16.0 z 32.0) (<= 64.0 t 128.0) (<= 256.0 a 512.0))
  (- x (/ (* y (- z t)) a)))
