(FPCore (A B C F)
  :name "ABCF->ab-angle a"
  :cx-source "herbie:mathematics/gui.fpcore:9"
  :cx-box "default"
  :precision binary64
  :pre (and (<= -2 A -1) (<= 4 B 8) (<= 16 C 32) (<= 64 F 128))
  (/ (- (sqrt (* (* 2 (* (- (* B B) (* (* 4 A) C)) F)) (+ (+ A C) (sqrt (+ (* (- A C) (- A C)) (* B B))))))) (- (* B B) (* (* 4 A) C))))
