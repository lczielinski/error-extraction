; from herbie numerics/rump.fpcore core 1
; 2 precondition conjunct(s) dropped, widening the box
; box: default
(FPCore (x y)
  :name "From Rump in a 1983 paper"
  :cx-source "herbie:numerics/rump.fpcore:1"
  :cx-box "default"
  :cx-kind "rewrite"
  :pre (and (<= 1.0 x 2.0) (<= 4.0 y 8.0))
  (+ (- (* 9 (* (* (* x x) x) x)) (* (* (* y y) y) y)) (* 2 (* y y))))
