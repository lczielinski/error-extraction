(FPCore (a b c d)
  :name "An eigenvalue calculation from TNG"
  :cx-source "fpbench:graphics.fpcore:0"
  :cx-box "default"
  :precision binary64
  :pre (and (<= 1 a 2) (<= 4 b 8) (<= 16 c 32) (<= 64 d 128))
  (- (sqrt (+ (* (+ a d) (+ a d)) (* (- b c) (- b c)))) (sqrt (+ (* (- a d) (- a d)) (* (+ b c) (+ b c))))))
