; from herbie haskell.fpcore core 10
; box: default
(FPCore (x y z t a)
  :name "Data.Colour.Matrix:inverse from colour-2.3.3, B"
  :cx-source "herbie:haskell.fpcore:10"
  :cx-box "default"
  :cx-kind "analysis"
  :pre (and (<= 1.0 x 2.0) (<= 4.0 y 8.0) (<= 16.0 z 32.0) (<= 64.0 t 128.0) (<= 256.0 a 512.0))
  (/ (- (* x y) (* z t)) a))
