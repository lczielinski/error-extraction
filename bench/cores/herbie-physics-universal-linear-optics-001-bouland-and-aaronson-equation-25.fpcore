(FPCore (a b)
  :name "Bouland and Aaronson, Equation (25)"
  :cx-source "herbie:physics/universal-linear-optics.fpcore:1"
  :cx-box "default"
  :precision binary64
  :pre (and (<= 1 a 2) (<= 4 b 8))
