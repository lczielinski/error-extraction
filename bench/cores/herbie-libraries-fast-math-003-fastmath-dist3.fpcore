; from herbie libraries/fast-math.fpcore core 3
; box: default
(FPCore (d1 d2 d3)
  :name "FastMath dist3"
  :cx-source "herbie:libraries/fast-math.fpcore:3"
  :cx-box "default"
  :cx-kind "rewrite"
  :pre (and (<= 1.0 d1 2.0) (<= 4.0 d2 8.0) (<= 16.0 d3 32.0))
  (+ (+ (* d1 d2) (* (+ d3 5) d1)) (* d1 32)))
