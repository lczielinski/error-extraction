(FPCore (x y z t a b c i j)
  :name "Data.Colour.Matrix:determinant from colour-2.3.3, A"
  :cx-source "herbie:haskell.fpcore:9"
  :cx-box "default"
  :precision binary64
  :pre (and (<= 1 x 2) (<= 4 y 8) (<= 16 z 32) (<= 64 t 128) (<= 256 a 512) (<= 1024 b 2048) (<= 4096 c 8192) (<= 16384 i 32768) (<= 65536 j 131072))
  (+ (- (* x (- (* y z) (* t a))) (* b (- (* c z) (* t i)))) (* j (- (* c a) (* y i)))))
