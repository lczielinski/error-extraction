(FPCore (x y z t)
  :name "Graphics.Rasterific.Svg.PathConverter:arcToSegments from rasterific-svg-0.2.3.1"
  :cx-source "herbie:haskell.fpcore:159"
  :cx-box "default"
  :precision binary64
  :pre (and (<= 1 x 2) (<= 4 y 8) (<= 16 z 32) (<= 64 t 128))
  (+ (/ (* x x) (* y y)) (/ (* z z) (* t t))))
