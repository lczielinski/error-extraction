; from herbie demo.fpcore core 10
; box: pre
(FPCore (x)
  :name "(x - 1) to (x - 20)"
  :cx-source "herbie:demo.fpcore:10"
  :cx-box "pre"
  :pre (<= 1.0 x 20.0)
