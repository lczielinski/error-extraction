(FPCore (t)
  :name "Kahan p13 Example 2"
  :cx-source "herbie:numerics/great-debate.fpcore:4"
  :cx-box "default"
  :precision binary64
  :pre (and (<= 1 t 2))
  (/ (+ 1 (* (- 2 (/ (/ 2 t) (+ 1 (/ 1 t)))) (- 2 (/ (/ 2 t) (+ 1 (/ 1 t)))))) (+ 2 (* (- 2 (/ (/ 2 t) (+ 1 (/ 1 t)))) (- 2 (/ (/ 2 t) (+ 1 (/ 1 t))))))))
