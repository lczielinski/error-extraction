(FPCore (m1 p1 m2 p2)
  :name "(E1 - p1) + (E2 - p2)"
  :cx-expected "(> p1 0), (> p2 0)"
  :cx-source "Wikipedia, Light-cone coordinates: P- of two particles"
  :pre (and (<= 0.1 m1 1) (<= -10 p1 10) (<= 0.1 m2 1) (<= -10 p2 10))
  (+ (- (sqrt (+ (* m1 m1) (* p1 p1))) p1) (- (sqrt (+ (* m2 m2) (* p2 p2))) p2)))
