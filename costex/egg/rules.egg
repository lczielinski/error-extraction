; Each rule keeps the real value of every class on the whole box. A rule may assume its
; left side is defined there (a divisor is nonzero, a radicand nonnegative); facts beyond
; that come from the intervals, and such a rule builds its right side only from matched
; terms, so a fact true in one arm of a branch is never applied to the other.

(birewrite (Add a b) (Add b a) :ruleset opt)
(birewrite (Mul a b) (Mul b a) :ruleset opt)
(birewrite (Add (Add a b) c) (Add a (Add b c)) :ruleset opt)
(birewrite (Mul (Mul a b) c) (Mul a (Mul b c)) :ruleset opt)
(birewrite (Neg (Add a b)) (Add (Neg a) (Neg b)) :ruleset opt)
(birewrite (Mul (Neg a) b) (Neg (Mul a b)) :ruleset opt)
(rewrite (Neg (Neg a)) a :ruleset opt)
(rewrite (Neg (Num n)) (Num (neg n)) :ruleset opt)
(rewrite (Neg (Add a (Neg b))) (Add b (Neg a)) :ruleset opt)

(rewrite (Add a (Num 0.0)) a :ruleset opt)
(rewrite (Mul a (Num 1.0)) a :ruleset opt)
(rewrite (Mul a (Num 0.0)) (Num 0.0) :ruleset opt)
(rewrite (Div a (Num 1.0)) a :ruleset opt)
(rewrite (Div (Num 0.0) a) (Num 0.0) :ruleset opt)
(rewrite (Add a (Neg a)) (Num 0.0) :ruleset opt)
(rewrite (Add (Add a b) (Neg a)) b :ruleset opt)
(rewrite (Add (Add a b) (Neg b)) a :ruleset opt)
(rewrite (Add a (Neg (Add a b))) (Neg b) :ruleset opt)
(rewrite (Add b (Neg (Add a b))) (Neg a) :ruleset opt)

(birewrite (Add a a) (Mul (Num 2.0) a) :ruleset opt)
(birewrite (Mul a (Add b c)) (Add (Mul a b) (Mul a c)) :ruleset opt)
(birewrite (Mul a (Add b (Neg c))) (Add (Mul a b) (Neg (Mul a c))) :ruleset opt)
(birewrite (Add a (Mul a b)) (Mul a (Add (Num 1.0) b)) :ruleset opt)
(birewrite (Add a (Neg (Mul a b))) (Mul a (Add (Num 1.0) (Neg b))) :ruleset opt)
(birewrite (Add (Mul a a) (Neg (Mul b b))) (Mul (Add a b) (Add a (Neg b))) :ruleset opt)

(rewrite (Div a a) (Num 1.0) :ruleset opt)
(rewrite (Div (Mul a b) b) a :ruleset opt)
(rewrite (Div (Mul a b) a) b :ruleset opt)
(rewrite (Mul b (Div a b)) a :ruleset opt)
(rewrite (Div (Mul a b) (Mul a c)) (Div b c) :ruleset opt)
(rewrite (Div (Num 1.0) (Div (Num 1.0) a)) a :ruleset opt)
(birewrite (Div a b) (Mul a (Div (Num 1.0) b)) :ruleset opt)
(birewrite (Div (Div a b) c) (Div a (Mul b c)) :ruleset opt)
(birewrite (Div (Add a b) c) (Add (Div a c) (Div b c)) :ruleset opt)
(birewrite (Div (Add a (Neg b)) c) (Add (Div a c) (Neg (Div b c))) :ruleset opt)
(rewrite (Add (Div a b) (Neg (Div c d))) (Div (Add (Mul a d) (Neg (Mul c b))) (Mul b d)) :ruleset opt)

(rewrite (Mul (Sqrt a) (Sqrt a)) a :ruleset opt)
(rewrite (Mul (Sqrt a) (Sqrt b)) (Sqrt (Mul a b)) :ruleset opt)
(rewrite (Div (Sqrt a) (Sqrt b)) (Sqrt (Div a b)) :ruleset opt)
(rule ((= e (Sqrt (Mul a a))) (Nonneg a)) ((union e a)) :ruleset opt)
(rule ((= e (Sqrt (Mul a b))) (Nonneg a) (Nonneg b)) ((union e (Mul (Sqrt a) (Sqrt b)))) :ruleset opt)
(rule ((= e (Sqrt (Div a b))) (Pos b)) ((union e (Div (Sqrt a) (Sqrt b)))) :ruleset opt)

; a - c = (a*a - c*c) / (a + c), with a + c built for each difference
(rule ((= e (Add a (Neg c)))) ((Add a c)) :ruleset opt)
(rule ((= e (Add a (Neg c))) (= d (Add a c)) (Nonzero d))
      ((union e (Div (Add (Mul a a) (Neg (Mul c c))) d))) :ruleset opt)
