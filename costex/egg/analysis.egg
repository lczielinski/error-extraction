; Terms of Section 4.1, with a - b written (Add a (Neg b)). (If x k a b) is a where x > k and
; b where x <= k, and (Ctx x k side e) marks e on one side of that split (below).
(datatype Math
  (Num BigRat)
  (Var String)
  (Add Math Math)
  (Mul Math Math)
  (Div Math Math)
  (Neg Math)
  (Sqrt Math)
  (If String f64 Math Math)
  (Ctx String f64 bool Math))

(let $zero (bigrat (bigint 0) (bigint 1)))
(let $one (bigrat (bigint 1) (bigint 1)))
(let $neg-one (bigrat (bigint -1) (bigint 1)))
(let $two (bigrat (bigint 2) (bigint 1)))
(let $half (bigrat (bigint 1) (bigint 2)))

; ana: the interval analysis; opt: rewrite rules; fold: constant folding; dist: moving Ctx
; markers to the leaves; branch: proposing splits (branch.egg)
(ruleset ana)
(ruleset opt)
(ruleset fold)
(ruleset dist)
(ruleset branch)

(relation Root (Math))
(relation Bad (Math))
(function lo (Math) f64 :merge (max old new))
(function hi (Math) f64 :merge (min old new))

; I_c, as (lo e) and (hi e) with binary64 endpoints. Each class's interval is the intersection
; of its nodes' intervals, which is what the merges compute.
;
; f64 rounds each formula below to nearest, so a rule puts the raw bound in rlo/rhi, which moves
; one relative step (2^-52) outward into lo/hi. That covers sums and square roots, which never
; round in the subnormals. A product, quotient or constant puts it in rmlo/rmhi, which also
; moves one subnormal outward. Negation and the sign rules are exact and set lo/hi directly.
; A raw bound that overflowed toward the inside of the interval says nothing and is dropped.
(function rlo (Math) f64 :merge (max old new))
(function rhi (Math) f64 :merge (min old new))
(function rmlo (Math) f64 :merge (max old new))
(function rmhi (Math) f64 :merge (min old new))
(rule ((= l (rlo e)) (< l inf))
      ((set (lo e) (min (* l 0.9999999999999998) (* l 1.0000000000000002)))) :ruleset ana)
(rule ((= h (rhi e)) (> h -inf))
      ((set (hi e) (max (* h 0.9999999999999998) (* h 1.0000000000000002)))) :ruleset ana)
(rule ((= l (rmlo e)) (< l inf))
      ((set (lo e) (min (min (* l 0.9999999999999998) (* l 1.0000000000000002)) (- l 4.9406564584124654e-324)))) :ruleset ana)
(rule ((= h (rmhi e)) (> h -inf))
      ((set (hi e) (max (max (* h 0.9999999999999998) (* h 1.0000000000000002)) (+ h 4.9406564584124654e-324)))) :ruleset ana)

; An empty interval means some subexpression is undefined on the box, and the input is rejected
(rule ((= l (lo e)) (= h (hi e)) (> l h)) ((Bad e)) :ruleset ana)

(rule ((= e (Num r))) ((set (rmlo e) (to-f64 r)) (set (rmhi e) (to-f64 r))) :ruleset ana)
(rule ((= e (Num $zero))) ((set (lo e) 0.0) (set (hi e) 0.0)) :ruleset ana)

(rule ((= e (Neg a)) (= h (hi a))) ((set (lo e) (neg h))) :ruleset ana)
(rule ((= e (Neg a)) (= l (lo a))) ((set (hi e) (neg l))) :ruleset ana)

(rule ((= e (Add a b)) (= la (lo a)) (= lb (lo b))) ((set (rlo e) (+ la lb))) :ruleset ana)
(rule ((= e (Add a b)) (= ha (hi a)) (= hb (hi b))) ((set (rhi e) (+ ha hb))) :ruleset ana)

(rule ((= e (Mul a b)) (= la (lo a)) (= ha (hi a)) (= lb (lo b)) (= hb (hi b))
       (> la -inf) (< ha inf) (> lb -inf) (< hb inf))
      ((set (rmlo e) (min (min (* la lb) (* la hb)) (min (* ha lb) (* ha hb))))
       (set (rmhi e) (max (max (* la lb) (* la hb)) (max (* ha lb) (* ha hb))))) :ruleset ana)
(rule ((= e (Mul a a))) ((set (lo e) 0.0)) :ruleset ana)
(rule ((= e (Mul a b)) (= la (lo a)) (= ha (hi a)) (= la 0.0) (= ha 0.0)) ((set (lo e) 0.0) (set (hi e) 0.0)) :ruleset ana)
(rule ((= e (Mul a b)) (= lb (lo b)) (= hb (hi b)) (= lb 0.0) (= hb 0.0)) ((set (lo e) 0.0) (set (hi e) 0.0)) :ruleset ana)
(rule ((= e (Mul a b)) (= la (lo a)) (= lb (lo b)) (>= la 0.0) (>= lb 0.0)) ((set (lo e) 0.0)) :ruleset ana)
(rule ((= e (Mul a b)) (= ha (hi a)) (= hb (hi b)) (<= ha 0.0) (<= hb 0.0)) ((set (lo e) 0.0)) :ruleset ana)
(rule ((= e (Mul a b)) (= la (lo a)) (= hb (hi b)) (>= la 0.0) (<= hb 0.0)) ((set (hi e) 0.0)) :ruleset ana)
(rule ((= e (Mul a b)) (= ha (hi a)) (= lb (lo b)) (<= ha 0.0) (>= lb 0.0)) ((set (hi e) 0.0)) :ruleset ana)

(rule ((= e (Div a b)) (= la (lo a)) (= ha (hi a)) (= lb (lo b)) (= hb (hi b))
       (> la -inf) (< ha inf) (> lb -inf) (< hb inf) (> (max lb (neg hb)) 0.0))
      ((set (rmlo e) (min (min (/ la lb) (/ la hb)) (min (/ ha lb) (/ ha hb))))
       (set (rmhi e) (max (max (/ la lb) (/ la hb)) (max (/ ha lb) (/ ha hb))))) :ruleset ana)
(rule ((= e (Div a b)) (= la (lo a)) (= lb (lo b)) (>= la 0.0) (> lb 0.0)) ((set (lo e) 0.0)) :ruleset ana)
(rule ((= e (Div a b)) (= ha (hi a)) (= hb (hi b)) (<= ha 0.0) (< hb 0.0)) ((set (lo e) 0.0)) :ruleset ana)
(rule ((= e (Div a b)) (= la (lo a)) (= hb (hi b)) (>= la 0.0) (< hb 0.0)) ((set (hi e) 0.0)) :ruleset ana)
(rule ((= e (Div a b)) (= ha (hi a)) (= lb (lo b)) (<= ha 0.0) (> lb 0.0)) ((set (hi e) 0.0)) :ruleset ana)

; The real semantics is defined on the box, so every radicand is nonnegative
(rule ((= e (Sqrt a))) ((set (lo a) 0.0)) :ruleset ana)
(rule ((= e (Sqrt a)) (= l (lo a)) (= h (hi a)) (>= h 0.0))
      ((set (rlo e) (sqrt (max l 0.0))) (set (rhi e) (sqrt h))) :ruleset ana)

; Sign facts from the intervals, for the conditional rules
(relation Pos (Math))
(relation Nonneg (Math))
(relation Nonzero (Math))
(relation Nonpos (Math))
(rule ((= l (lo e)) (> l 0.0)) ((Pos e) (Nonzero e)) :ruleset ana)
(rule ((= l (lo e)) (>= l 0.0)) ((Nonneg e)) :ruleset ana)
(rule ((= h (hi e)) (<= h 0.0)) ((Nonpos e)) :ruleset ana)
(rule ((= h (hi e)) (< h 0.0)) ((Nonzero e)) :ruleset ana)

; (Ctx x k true e) is e where x > k and (Ctx x k false e) is e where x <= k. Each moves
; down to the leaves, where it narrows (Var x) and is the identity on every other leaf. At
; a constant it stops: subsuming keeps it from moving into the terms equal to that constant.
(relation Leaf (Math))
(rule ((= e (Var x))) ((Leaf e)) :ruleset dist)
(rule ((= e (Ctx x k s (Var x)))) ((Leaf e)) :ruleset dist)
(rule ((= e (Ctx x k s u)) (Leaf u) (= v (Var x)) (!= u v)) ((union e u)) :ruleset dist)
(rewrite (Ctx x k s (Num n)) (Num n) :subsume :ruleset dist)
(rewrite (Ctx x k s (Add a b)) (Add (Ctx x k s a) (Ctx x k s b)) :ruleset dist)
(rewrite (Ctx x k s (Mul a b)) (Mul (Ctx x k s a) (Ctx x k s b)) :ruleset dist)
(rewrite (Ctx x k s (Div a b)) (Div (Ctx x k s a) (Ctx x k s b)) :ruleset dist)
(rewrite (Ctx x k s (Neg a)) (Neg (Ctx x k s a)) :ruleset dist)
(rewrite (Ctx x k s (Sqrt a)) (Sqrt (Ctx x k s a)) :ruleset dist)

; A marker's interval is within its child's, and narrows x to its side of k. An If's is the
; hull of its arms'.
(rule ((= e (Ctx x k s a)) (= l (lo a))) ((set (lo e) l)) :ruleset ana)
(rule ((= e (Ctx x k s a)) (= h (hi a))) ((set (hi e) h)) :ruleset ana)
(rule ((= e (Ctx x k true (Var x)))) ((set (lo e) k)) :ruleset ana)
(rule ((= e (Ctx x k false (Var x)))) ((set (hi e) k)) :ruleset ana)
(rule ((= e (If x k a b)) (= la (lo a)) (= lb (lo b))) ((set (lo e) (min la lb))) :ruleset ana)
(rule ((= e (If x k a b)) (= ha (hi a)) (= hb (hi b))) ((set (hi e) (max ha hb))) :ruleset ana)
